(optional (typeattribute trivalent_restricted_launch)
          (typeattributeset trivalent_restricted_launch (and (domain) (not (trivalent_domain trivalent_script_domain))))
          (deny trivalent_restricted_launch trivalent_domain (process (transition dyntransition))))