[Unit]
Description=Workaround for missing SELinux module rebuilding in bootc
ConditionKernelCommandLine=composefs
After=local-fs.target
Before=systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/secureblue/bootc-selinux-workaround

[Install]
WantedBy=multi-user.target
