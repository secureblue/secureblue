variant: fcos
version: 1.7.0
passwd:
  users:
    - name: core
      groups:
        - wheel
      password_hash: $y$j9T$mefBCJbp/a49aSkTT4hpE1$6BXtrIuV8856t4A9r/R1GW4aR9eKXxsmB8FXt56Hx70 # 'secureblue'
      ssh_authorized_keys:
        - ssh-ed25519 <key>

systemd:
  units:
    - name: zincati.service
      enabled: false
      mask: true

storage:
  links:
    - path: /etc/systemd/system/rpm-ostreed.service.d/coreos-containers-policy.conf
      target: /dev/null

  files:
    - path: /etc/containers/policy.json
      mode: 0644
      overwrite: true
      contents:
        inline: |
          {
            "default": [{"type": "reject"}],
            "transports": {
              "docker": {
                "ghcr.io/secureblue": [
                  {
                    "type": "sigstoreSigned",
                    "keyPath": "/etc/pki/containers/secureblue-2025.pub",
                    "signedIdentity": {"type": "matchRepository"}
                  }
                ]
              }
            }
          }

    - path: /etc/containers/registries.d/secureblue.yaml
      mode: 0644
      contents:
        inline: |
          docker:
            ghcr.io/secureblue:
              use-sigstore-attachments: true

    - path: /etc/pki/containers/secureblue-2025.pub
      mode: 0644
      overwrite: true
      contents:
        source: https://raw.githubusercontent.com/secureblue/secureblue/refs/heads/live/files/system/usr/share/pki/containers/secureblue-2025.pub
        verification:
          hash: sha256-9cbd48de48d467f86e0f31f9454c6e0bb663f3d033ecd92143f62577eb1cb5eb

    - path: /root/akmods-secureblue.der
      mode: 0644
      overwrite: true
      contents:
        source: https://raw.githubusercontent.com/secureblue/secureblue/refs/heads/live/files/system/usr/share/pki/akmods/certs/akmods-secureblue.der
        verification:
          hash: sha256-fb8491059eabecf332f6a9e01e3aa35f0832f2f4d43df3f6f5ce2dfdac0ba9a8

    - path: /opt/install_securecore.py
      mode: 0755
      overwrite: true
      contents:
        source: https://raw.githubusercontent.com/secureblue/secureblue/refs/heads/live/docs/install_securecore.py
        verification:
          hash: sha256-bd9019213819a22b97f669b8d29a12aebdda8f98a74380782cfacf80b5f7c9c0

    - path: /var/home/core/.bash_profile
      overwrite: false
      append:
      - inline: |
          /usr/bin/python3 -I /opt/install_securecore.py main-hardened:latest
