########################################
## <summary>
##	Execute bazaar in the bazaar domain.
## </summary>
## <param name="domain">
## <summary>
##	Domain allowed to transition.
## </summary>
## </param>
#
interface(`bazaar_domtrans',`
	gen_require(`
		type bazaar_t, bazaar_exec_t;
	')

	domtrans_pattern($1, bazaar_exec_t, bazaar_t)
')


########################################
## <summary>
##	Execute bazaar in the bazaar domain.
## </summary>
## <param name="domain">
## <summary>
##	Domain allowed to transition.
## </summary>
## </param>
## <param name="role">
##	<summary>
##	Role allowed access.
##	</summary>
## </param>
#
interface(`bazaar_run',`
	gen_require(`
		type bazaar_t;
        attribute_role bazaar_roles;
	')

	bazaar_domtrans($1)
	roleattribute $2 bazaar_roles;
')
