[Unit]
Description=secureblue flatpak setup
Wants=network-online.target
After=network-online.target
ConditionPathExists=!~/.config/secureblue/secureblue-flatpak-setup.stamp

[Service]
Type=oneshot
ExecStart=/usr/libexec/secureblue/secureblueflatpaksetup
ExecStartPost=bash -c 'mkdir -p ~/.config/secureblue && touch ~/.config/secureblue/secureblue-flatpak-setup.stamp'
