[fedora-nvidia]
name=negativo17 - Nvidia
baseurl=https://negativo17.org/repos/nvidia/fedora-$releasever/$basearch/
enabled=0
priority=90
skip_if_unavailable=1
gpgcheck=1
# gpgkey=https://negativo17.org/repos/RPM-GPG-KEY-slaanesh
gpgkey=file:///usr/share/pki/rpm-gpg/RPM-GPG-KEY-slaanesh.gpg
enabled_metadata=1
metadata_expire=6h
type=rpm-md
repo_gpgcheck=0
includepkgs=akmod-nvidia,nvidia-kmod-common,nvidia-modprobe,nvidia-driver-selinux,libnvidia-fbc,nvidia-driver,nvidia-driver-cuda,nvidia-settings,
    nvidia-driver-common,nvidia-driver-cuda-libs,nvidia-driver-libs,nvidia-libXNVCtrl,nvidia-persistenced

[fedora-nvidia-source]
name=negativo17 - Nvidia - Source
baseurl=https://negativo17.org/repos/nvidia/fedora-$releasever/SRPMS
enabled=0
skip_if_unavailable=1
gpgcheck=1
# gpgkey=https://negativo17.org/repos/RPM-GPG-KEY-slaanesh
gpgkey=file:///usr/share/pki/rpm-gpg/RPM-GPG-KEY-slaanesh.gpg
enabled_metadata=1
metadata_expire=6h
type=rpm-md
repo_gpgcheck=0

[fedora-nvidia-debug]
name=negativo17 - Nvidia - Debug
baseurl=https://negativo17.org/repos/nvidia/fedora-$releasever/$basearch.debug/
enabled=0
skip_if_unavailable=1
gpgcheck=1
# gpgkey=https://negativo17.org/repos/RPM-GPG-KEY-slaanesh
gpgkey=file:///usr/share/pki/rpm-gpg/RPM-GPG-KEY-slaanesh.gpg
enabled_metadata=1
metadata_expire=6h
type=rpm-md
repo_gpgcheck=0
