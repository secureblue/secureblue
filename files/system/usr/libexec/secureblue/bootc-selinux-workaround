#!/usr/bin/bash
set -euo pipefail

PATH=/usr/bin
TIMESTAMP=$(bootc status --booted --format json | jq -r '.status.booted.image.timestamp')

if ! [[ -e /var/lib/secureblue/bootc-selinux-workaround-$TIMESTAMP.stamp ]]; then
    rm -f /var/lib/secureblue/bootc-selinux-workaround-*.stamp
    semodule -B
    restorecon -R /tmp
    touch /var/lib/secureblue/bootc-selinux-workaround-$TIMESTAMP.stamp
fi
