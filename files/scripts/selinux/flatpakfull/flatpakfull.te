policy_module(flatpakfull, 1.0.0)

# SPDX-FileCopyrightText: Copyright 2025-2026 The Secureblue Authors
#
# SPDX-License-Identifier: Apache-2.0 OR MIT

########################################
#
# Declarations
#

attribute_role flatpak_roles;
roleattribute object_r flatpak_roles;



type flatpak_t;
type flatpak_exec_t;
domain_type(flatpak_t, flatpak_exec_t)
application_domain(flatpak_t, flatpak_exec_t)

role flatpak_roles types flatpak_t;

unconfined_domain_noaudit(flatpak_t)

optional_policy(`
	rtkit_scheduled(flatpak_t)
')

# allow flatpaks to write to tmp fiels/dirs as usr_tmp_t
userdom_tmpfs_filetrans(flatpak_t, { dir fifo_file file lnk_file sock_file })
userdom_tmp_filetrans_user_tmp(flatpak_t, { dir fifo_file file lnk_file sock_file })

gen_require(`
	type unconfined_t;
	role unconfined_r;
')

# run bubblewrap as flatpak_bubblewrap_t
bubblewrap_role(flatpak, flatpak_t, unconfined_r)
bubblewrap_nnp_domtrans(flatpak, flatpak_t)

flatpak_run(unconfined_t, unconfined_r)

optional_policy(`
	gen_require(`
		type unconfined_trivalent_t;
		attribute trivalent_domain;
		role unconfined_r;
		bool trivalent_exec_flatpaks;
	')

	# required for trivalent/flatpak clipboard sharing
	allow trivalent_domain flatpak_t:fifo_file write;

	# required for trivalent execution of flatpaks
	tunable_policy(`trivalent_exec_flatpaks', `
		allow trivalent_domain flatpak_t:process2 { nnp_transition nosuid_transition };
		allow flatpak_bubblewrap_t unconfined_trivalent_t:fifo_file { read write };
		flatpak_domtrans(unconfined_trivalent_t)
	')
')
