[Unit]
Description=secureblue bazaar setup
Wants=network-online.target secureblue-flatpak-setup.service
After=network-online.target secureblue-flatpak-setup.service
ConditionUser=!@system
ConditionPathIsDirectory=/var/home/%u
ConditionPathExists=!%S/secureblue/secureblue-bazaar-setup.stamp

[Service]
Type=oneshot
ExecStart=/usr/libexec/secureblue/secureblue-bazaar-setup
ExecStartPost=/usr/bin/touch %S/secureblue/secureblue-bazaar-setup.stamp
Restart=on-failure
RestartSec=30s
RestartMaxDelaySec=1800s
RestartSteps=10
