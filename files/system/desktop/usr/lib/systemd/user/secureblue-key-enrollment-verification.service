[Unit]
Description=secureblue secure boot key enrollment verification
Wants=dbus.service
After=dbus.service
ConditionUser=!@system
ConditionPathIsDirectory=/var/home/%u

[Service]
Type=oneshot
ExecCondition=/bin/bash -c 'ujust enroll-secure-boot-keys status | grep -Fq "Status: not enrolled"'
ExecStart=/usr/libexec/secureblue/securebluesecurebootnotify
