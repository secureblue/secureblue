#: files/system/usr/libexec/secureblue/utils/__init__.py:83
msgid ""
"The following status indicators accompany checks run by the audit script:"
msgstr "I seguenti indicatori di stato accompagnano le verifiche eseguite dallo script di controllo:"

#: files/system/usr/libexec/secureblue/utils/__init__.py:86
msgid "check failed - the configuration may be less secure."
msgstr "Controllo fallito – la configurazione potrebbe essere meno sicura."

#: files/system/usr/libexec/secureblue/utils/__init__.py:87
msgid "partial failure, or less significant issue detected."
msgstr "Fallimento parziale, o rilevato un problema meno significativo."

#: files/system/usr/libexec/secureblue/utils/__init__.py:88
msgid "check passed - no problems detected."
msgstr "controllo superato – non sono stati rilevati problemi."

#: files/system/usr/libexec/secureblue/utils/__init__.py:89
msgid "unable to perform check (usually due to a file permission issue)."
msgstr "Impossibile eseguire il controllo (solitamente a causa di un problema di permessi)"

#: files/system/usr/libexec/secureblue/utils/__init__.py:94
msgid "For flatpak checks, the status indicators have more specific meanings:"
msgstr "Per i controlli flatpak, gli indicatori di stato hanno significati più specifici:"

#: files/system/usr/libexec/secureblue/utils/__init__.py:97
msgid ""
"app has permissions that can be used as sandbox escapes, allow it to modify\n"
"            its own permissions, or otherwise grant very broad access to the "
"system (e.g. access\n"
"            to certain directories, direct D-Bus access, X11)."
msgstr "L’app ha permessi che possono essere usati come vettori di evasione dal sandbox, le consentono di modificare i propri permessi, o che comunque garantiscono un accesso molto ampio al sistema (per esempio, accesso a determinate cartelle, accesso diretto a D-Bus, X11)."

#: files/system/usr/libexec/secureblue/utils/__init__.py:100
msgid ""
"app has permissions that have some sandbox escape potential or otherwise\n"
"            weaken security (e.g. PulseAudio, Bluetooth, not using "
"hardened_malloc)."
msgstr "L’applicazione ha permessi che sono potenziali vettori di evasione dalla sandbox oppure indeboliscono la sicurezza (per esempio, PulseAudio, Bluetooth, inutilizzo di hardened_malloc)."

#: files/system/usr/libexec/secureblue/utils/__init__.py:102
msgid ""
"no potential sandbox escapes detected but some permissions could increase\n"
"            attack surface or have privacy implications (e.g. network "
"access)."
msgstr "Non sono stati rilevati potenziali vettori di evasione della sandbox ma alcuni permessi potrebbero aumentare la superficie d’attacco o avere implicazioni relative alla privacy (per esempio, accesso al network)."

#: files/system/usr/libexec/secureblue/utils/__init__.py:104
msgid "no app permissions flagged (however, not all permissions are audited)."
msgstr "Nessun permesso delle applicazioni segnalato (tuttavia, non tutti i permessi sono stati controllati)."

#: files/system/usr/libexec/secureblue/utils/__init__.py:110
msgid ""
"            Note that some flatpak apps require broad permissions to "
"function. Permissions being\n"
"            flagged by the audit script do not necessarily mean that action "
"should be taken.\n"
"            "
msgstr "Nota che alcune applicazioni flatpak richiedono ampi permessi per funzionare. I permessi che sono stati segnalati dallo script di controllo non significano necessariamente che si debba intervenire."
