set -euo pipefail

FLATPAK_REMOTES=$(flatpak remotes --user --columns=name)

flatpak remote-add --if-not-exists --user --subset=verified flathub https://dl.flathub.org/repo/flathub.flatpakrepo

if grep -Fqx 'flathub-verified' <<<"${FLATPAK_REMOTES}"; then
    readarray -t verified_refs < <(flatpak list --user --all --columns=ref,origin | awk '$2 == "flathub-verified" { print $1 }')
    for verified_ref in "${verified_refs[@]}"; do
        flatpak install --user --reinstall --no-auto-pin -y --noninteractive flathub "${verified_ref}"
    done

    flatpak remote-delete --user flathub-verified || true
fi

flatpak override --user --filesystem=host-etc:ro --share=network --talk-name=org.freedesktop.Flatpak io.github.kolunmi.Bazaar
flatpak install --user --noninteractive flathub io.github.kolunmi.Bazaar -y
flatpak run --command=gsettings io.github.kolunmi.Bazaar set io.github.kolunmi.Bazaar auto-update true
if flatpak remotes --user --columns=name,subset | grep -Eqx 'flathub[[:blank:]]+verified'; then
    flatpak run --command=gsettings io.github.kolunmi.Bazaar set io.github.kolunmi.Bazaar show-only-verified true
fi
systemctl --user start --no-block app-io.github.kolunmi.Bazaar@autostart.service
