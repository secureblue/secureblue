/* Overwrites polkit rule that allows rpm-ostree install to be used without wheel auth
   Allows only upgrades without wheel auth
 */
polkit.addRule(function(action, subject) {
    if (action.id === "org.projectatomic.rpmostree1.upgrade" &&
        subject.active === true &&
        subject.local === true) {
            return polkit.Result.YES;
    }
});
