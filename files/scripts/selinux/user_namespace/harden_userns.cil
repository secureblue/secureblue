(typeattribute userns_privileged_domain)
(typeattributeset userns_privileged_domain (init_t install_t kernel_t))
(optional bubblewrap_userns_privileged_domain
          (typeattributeset userns_privileged_domain (bubblewrap_domain)))
(optional container_userns_privileged_domain
          (typeattributeset userns_privileged_domain (container_domain container_runtime_domain spc_t)))
(optional flatpak_helper_userns_privileged_domain
          (typeattributeset userns_privileged_domain (flatpak_helper_t)))
(optional passt_userns_privileged_domain
          (typeattributeset userns_privileged_domain (passt_t)))
(optional stdmalloc_userns_privileged_domain
          (typeattributeset userns_privileged_domain (stdmalloc_t)))
(optional systemsettings_userns_privileged_domain
          (typeattributeset userns_privileged_domain (systemsettings_t)))
(optional thumb_userns_privileged_domain
          (typeattributeset userns_privileged_domain (thumb_t)))
(optional trivalent_userns_privileged_domain
          (typeattributeset userns_privileged_domain (trivalent_domain trivalent_script_domain)))

(typeattribute userns_restricted_domain)
(typeattributeset userns_restricted_domain (and (domain) (not (userns_privileged_domain))))

;; These are denied by default via the container userns policy,
;; but permitted here so that they are allowed when the container policy is lifted
(typeattribute container_userns_join_permitted_domain)
(typeattributeset container_userns_join_permitted_domain (pasta_t mount_t))

(typeattribute userns_restricted_join_domain)
(typeattributeset userns_restricted_join_domain (and (userns_restricted_domain) (not (container_userns_join_permitted_domain))))

(deny userns_restricted_domain self (user_namespace (create)))
(deny userns_restricted_domain userns_privileged_domain (process (noatsecure)))
(deny userns_restricted_join_domain self (cap_userns (sys_admin)))

(constrain (process (transition dyntransition))
    (or (neq r1 unconfined_r) ;; don't constrain switching out of roles other than unconfined_r
        (or (eq r2 unconfined_r) ;; don't constrain switching into unconfined_r
            (or (eq t2 install_t) ;; unless switching into install_t
                (and (eq t1 container_runtime_domain) ;; unless it's the container runtime domain switching into a container domain
                    (eq t2 (container_domain spc_t)))))))


(constrain (process (transition dyntransition))
    (or (neq t1 (container_domain spc_t)) ;; don't constrain switching out of types other than container domains
        (eq t2 (container_domain spc_t)))) ;; don't constrain if the target type is a container domain
